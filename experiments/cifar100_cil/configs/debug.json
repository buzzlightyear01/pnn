{
  "batch_size": 16,
  "num_workers": 2,
  "epochs_per_task": 1,

  "pretrained": false,

  "optimizer": {
    "lr": 0.01,
    "momentum": 0.9,
    "weight_decay": 0.0005
  },

  "max_tasks": 1,

  "pnn": {
    "beta": 0.99,
    "eps": 1e-8,
    "kappa": 1.0,
    "gamma": 1.0,
    "lambda_max": 100.0,
    "mu_min": 0.1,
    "mu_max": 1.0,
    "warmup_epochs": 0,
    "grouping": "layer",
    "adaptive_enabled": false
  }
}
