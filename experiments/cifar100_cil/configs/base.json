{
  "epochs_per_task": 50,
  "batch_size": 128,
  "num_workers": 2,
  "optimizer": {
    "type": "sgd",
    "lr": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0005
  },
  "pnn": {
    "beta": 0.99,
    "kappa": 1.0,
    "gamma": 1.0,
    "mu_min": 0.1,
    "mu_max": 1.0,
    "lambda_max": 100.0,
    "warmup_epochs": 2
  }
}
